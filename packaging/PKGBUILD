# Maintainer: Cristian Moraru <info@thekrystalship.com>
#
# Build from this directory:  cd packaging && makepkg
#
# Compiles nothing. CI publishes first and this places the result, so the packaged bytes are the
# tested bytes. Point KGSM_STAGE at that publish output, or leave it unset to use
# ../artifacts/publish, which is where deploy.sh leaves one.
#
# The install prefix stays /opt/kgsm-scheduler, the same path deploy.sh uses on a development host, so the
# systemd unit is byte-identical whether it came from a package or a deploy. A unit rewritten at
# packaging time is a unit nobody tested.

pkgname=kgsm-scheduler
pkgver=2.10.0
pkgrel=1
pkgdesc="KGSM scheduler — scheduled restarts, backups and update sweeps"
arch=('x86_64')
url="https://github.com/TheKrystalShip/kgsm-scheduler"
license=('GPL-3.0-or-later')
groups=('kgsm-node')
# No separate debug package: these are shipped to a private fleet, not a distro archive.
options=('!debug')
# kgsm-base carries the kgsm service account this unit runs as, the /var/lib/kgsm tree it writes its
# descriptor and command manifest into, and the preset policy deciding whether it runs here.
depends=('kgsm-base' 'kgsm' 'kgsm-watchdog' 'systemd' 'glibc')
backup=('etc/kgsm-scheduler/kgsm-scheduler.env')
install="${pkgname}.install"

_stage() { printf '%s' "${KGSM_STAGE:-${startdir}/../artifacts/publish}"; }

pkgver() {
    "${startdir}/../deploy/version.sh" --pkgver
}

build() {
    local stage; stage="$(_stage)"
    [[ -e "${stage}/kgsm-scheduler" ]] || {
        printf '\n  no publish output at %s\n' "$stage" >&2
        printf '  build it first:  dotnet publish src/Scheduler/Scheduler.csproj -c Release -r linux-x64 -o artifacts/publish\n' >&2
        printf '  or point KGSM_STAGE at an existing one.\n\n' >&2
        return 1
    }
}

package() {
    local repo="${startdir}/.." stage; stage="$(_stage)"
    local prefix="${pkgdir}/opt/kgsm-scheduler"

    install -dm755 "$prefix"
    cp -a "${stage}/." "${prefix}/"
    # Debug artifacts a published tree carries and a package should not.
    rm -f "${prefix}"/*.pdb "${prefix}"/*.dbg

    install -Dm644 "${repo}/deploy/kgsm-scheduler.service" \
        "${pkgdir}/usr/lib/systemd/system/kgsm-scheduler.service"

    # Seeded from the committed example and listed in backup=(), so an upgrade writes .pacnew beside
    # a file you edited rather than over it. Secrets are set here and ship in no package.
    install -Dm640 "${repo}/deploy/kgsm-scheduler.env.example" \
        "${pkgdir}/etc/kgsm-scheduler/kgsm-scheduler.env"

    # The leaf config descriptor, in the directory kgsm-api scans. Packaged rather than installed by
    # a script, so it can never describe a different build than the one beside it.
    install -Dm644 "${repo}/deploy/kgsm-scheduler.leaf.json" \
        "${pkgdir}/var/lib/kgsm/leaves/scheduler.json"

    # The command catalog kgsm-api scans to list this leaf's commands. A subdirectory, because the
    # descriptor scan globs *.json at the level above and would read it as a malformed descriptor.
    install -Dm644 "${repo}/deploy/kgsm-scheduler.commands.json" \
        "${pkgdir}/var/lib/kgsm/leaves/commands/scheduler.json"

    install -Dm644 "${repo}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

}
