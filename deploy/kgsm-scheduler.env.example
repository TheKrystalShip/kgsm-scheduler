# kgsm-scheduler — configuration (systemd EnvironmentFile format: KEY=VALUE, # comments).
#
# Copy to /etc/kgsm-scheduler/kgsm-scheduler.env, edit, and reference it from the unit with
#   EnvironmentFile=-/etc/kgsm-scheduler/kgsm-scheduler.env
#
# kgsm-scheduler.settings.json, installed beside the binary, declares every knob with its default.
# A variable here overrides ONE key of that file, spelling its path with "__". A variable naming a
# key the file does not declare binds to nothing, so check the spelling against that file.
#
# Defaults are shown in [brackets]; uncomment a line only to override one.

# ── Connections ───────────────────────────────────────────────────────────────
# Path to the KGSM executable, read for each server's schedule. Checked at startup — the daemon
# refuses to run if nothing is there.                                     [/usr/bin/kgsm]
#Scheduler__KgsmPath=/usr/bin/kgsm

# The watchdog's control socket. Every scheduled restart is issued through the watchdog, never
# directly, so this has to match the path the watchdog listens on.
#                                                     [/run/kgsm-watchdog/control.sock]
#Scheduler__WatchdogSocketPath=/run/kgsm-watchdog/control.sock

# Unix socket the schedule snapshot is served on, one NDJSON line per connection. The Control Panel
# reads it here. The unit creates the parent directory (RuntimeDirectory=kgsm-scheduler), so moving
# this outside /run/kgsm-scheduler means creating that directory yourself.
#                                                     [/run/kgsm-scheduler/status.sock]
#Scheduler__StatusSocketPath=/run/kgsm-scheduler/status.sock

# ── Timing ────────────────────────────────────────────────────────────────────
# How often each server's schedule is re-read from KGSM (seconds). This bounds how quickly a
# schedule change takes effect; it does not affect the accuracy of a fire already scheduled.
# Anything below 5 is raised to 5.                                                    [60]
#Scheduler__PollIntervalSeconds=60

# How late a missed restart may be and still run (minutes). Anything later is skipped, so a host
# that was down does not come back to a burst of catch-up restarts. Zero always runs them.  [10]
#Scheduler__GraceWindowMinutes=10

# ── Logging ───────────────────────────────────────────────────────────────────
# Minimum severity logged, to the journal.                                  [Information]
#Logging__LogLevel__Default=Information
