# kgsm-scheduler — configuration (systemd EnvironmentFile format: KEY=VALUE, # comments).
#
# Copy to /etc/kgsm-scheduler/kgsm-scheduler.env, edit, and reference it from the unit with
#   EnvironmentFile=-/etc/kgsm-scheduler/kgsm-scheduler.env
#
# kgsm-scheduler.settings.json, installed beside the binary, declares every knob with its default.
# A variable here overrides ONE key of that file, spelling its path with "__". A variable naming a
# key the file does not declare binds to nothing, so check the spelling against that file.
#
# Defaults are shown in [brackets]; uncomment a line only to override one.

# ── Connections ───────────────────────────────────────────────────────────────
# Path to the KGSM executable, read for each server's schedule. Checked at startup — the daemon
# refuses to run if nothing is there.                                     [/usr/bin/kgsm]
#Scheduler__KgsmPath=/usr/bin/kgsm

# The watchdog's control socket. Every scheduled restart is issued through the watchdog, never
# directly, so this has to match the path the watchdog listens on.
#                                                     [/run/kgsm-watchdog/control.sock]
#Scheduler__WatchdogSocketPath=/run/kgsm-watchdog/control.sock

# Unix socket the daemon answers on, over HTTP: the schedule snapshot is a GET and an instruction
# is a POST. The unit creates the parent directory (RuntimeDirectory=kgsm-scheduler), so moving
# this outside /run/kgsm-scheduler means creating that directory yourself.
#                                                  [/run/kgsm-scheduler/scheduler.sock]
#Scheduler__SocketPath=/run/kgsm-scheduler/scheduler.sock

# Unix socket the daemon answers for ITSELF on: its configuration, its unit, its journal and the
# commands it declares. The Control Panel reaches it through the node's API, which relays here.
#                                                    [/run/kgsm-scheduler/surface.sock]
#Scheduler__SurfaceSocketPath=/run/kgsm-scheduler/surface.sock

# The env file a configuration change made through the Control Panel is written to. It has to be a
# file this unit loads with EnvironmentFile=, or the panel reports the settings read-only.
#                                       [/var/lib/kgsm-api/leaf-overrides/scheduler.env]
#Scheduler__ConfigOverridePath=/var/lib/kgsm-api/leaf-overrides/scheduler.env

# ── Timing ────────────────────────────────────────────────────────────────────
# How often each server's schedule is re-read from KGSM (seconds). This bounds how quickly a
# schedule change takes effect; it does not affect the accuracy of a fire already scheduled.
# Anything below 5 is raised to 5.                                                    [60]
#Scheduler__PollIntervalSeconds=60

# How late a missed maintenance window may be and still run (minutes). Anything later is skipped,
# so a host that was down does not come back to a burst of catch-up work. Capped at half the
# window's own period, and floored at one poll interval.                                    [10]
#Scheduler__GraceWindowMinutes=10

# ── Host policy ───────────────────────────────────────────────────────────────
# The shortest period this host permits a maintenance window to have (minutes). A window asking to
# run more often is reported as one this host will not fire. Anything below 10 is raised to 10.
#                                                                                           [10]
#Scheduler__MinimumWindowPeriodMinutes=10

# Whether maintenance that interrupts the people on a server — a restart, or an update — may run on
# this host at all. False leaves backups running as normal; anything disruptive is recorded as
# skipped and the windows carrying it are not announced.                                  [true]
#Scheduler__AllowDisruptiveTasks=true

# ── Game updates ──────────────────────────────────────────────────────────────
# Whether to sweep every server for a newer game build. False means nothing on this host ever
# asks upstream, so no update is announced.                                          [true]
#Scheduler__UpdateCheckEnabled=true

# How often the whole roster is swept (minutes). Each server asks its own upstream, so the cost
# is linear in servers. Anything below 5 is raised to 5.                               [60]
#Scheduler__UpdateCheckIntervalMinutes=60

# Pause between one server's check and the next, within a sweep (seconds). The sweep is serial
# by design; this spreads the requests out further. Zero checks back to back.           [5]
#Scheduler__UpdateCheckStaggerSeconds=5

# ── Logging ───────────────────────────────────────────────────────────────────
# Minimum severity logged, to the journal.                                  [Information]
#Logging__LogLevel__Default=Information
