{
  // === KGSM Scheduler — configuration ===
  // Every key below is also overridable by an environment variable of the SAME name
  // (env wins over this file). Edit values here for local defaults, or set the matching
  // KGSM_SCHEDULER_* env var on the deployed host.

  // Path to the kgsm binary. The scheduler validates this exists at startup.
  "KGSM_SCHEDULER_KGSM_PATH": "/usr/bin/kgsm",
  // kgsm event socket — used by kgsm-lib's instance service to read schedule config.
  "KGSM_SCHEDULER_KGSM_SOCKET": "/run/kgsm/events.sock",
  // kgsm-watchdog control socket — scheduler issues restarts through the watchdog.
  "KGSM_SCHEDULER_WATCHDOG_SOCKET": "/run/kgsm-watchdog/control.sock",
  // Status unix socket — serves the NDJSON status snapshot (one line per connect).
  // kgsm-api connects here for the /settings aggregation.
  "KGSM_SCHEDULER_STATUS_SOCKET": "/run/kgsm-scheduler/status.sock",
  // How often to re-scan instance schedule config (seconds). Floor ~5.
  "KGSM_SCHEDULER_POLL_INTERVAL": "60",
  // If a scheduled fire is more than this many minutes late (host was down, daemon
  // was stopped), skip it rather than firing a surprise restart. Prevents catch-up storms.
  "KGSM_SCHEDULER_GRACE_WINDOW_MINUTES": "10"
}
