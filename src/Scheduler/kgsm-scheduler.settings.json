{
  // === KGSM Scheduler — configuration ===
  //
  // This file declares the daemon's WHOLE configurable surface, each key with its default. It is
  // the floor; an environment variable overrides one key of it by spelling that key's path with
  // "__" — Scheduler__PollIntervalSeconds, Logging__LogLevel__Default. A variable naming a key
  // that is not declared here binds to nothing.
  //
  // Every key below maps 1:1 onto a property of SchedulerSettings, which the daemon binds in one
  // step. A test fails the build if the two ever disagree, in either direction.

  "Scheduler": {
    // Path to the KGSM executable, read for each server's schedule. Checked at startup — the
    // daemon refuses to run if nothing is there.
    "KgsmPath": "/usr/bin/kgsm",

    // The watchdog's control socket. Every scheduled restart is issued through the watchdog,
    // never directly, so this has to match the path the watchdog listens on.
    "WatchdogSocketPath": "/run/kgsm-watchdog/control.sock",

    // Unix socket the schedule snapshot is served on, one NDJSON line per connection. The
    // Control Panel reads it here to show what is scheduled and when it last ran. The unit
    // creates the parent directory (RuntimeDirectory=kgsm-scheduler).
    "StatusSocketPath": "/run/kgsm-scheduler/status.sock",

    // Unix socket the daemon takes instructions on — postponing a scheduled restart, for instance.
    // Separate from the status socket, whose contract is that a client only ever reads.
    "ControlSocketPath": "/run/kgsm-scheduler/control.sock",

    // How often each server's schedule is re-read from KGSM (seconds). This bounds how quickly a
    // schedule change takes effect; it does not affect the accuracy of a fire already scheduled.
    // Anything below 5 is raised to 5.
    "PollIntervalSeconds": 60,

    // How late a missed restart may be and still run (minutes). Anything later is skipped, so a
    // host that was down does not come back to a burst of catch-up restarts. Zero always runs them.
    "GraceWindowMinutes": 10,

    // Whether to sweep every server for a newer game build. False means nothing on this host ever
    // asks upstream, so no update is announced — servers keep running exactly as they are.
    "UpdateCheckEnabled": true,

    // How often the whole roster is swept (minutes). A game release is not a fast-moving fact and
    // each server asks its own upstream, so the cost is linear in servers. Anything below 5 is
    // raised to 5.
    "UpdateCheckIntervalMinutes": 60,

    // Pause between one server's check and the next, within a sweep (seconds). The sweep is serial
    // by design; this spreads the requests out further still.
    "UpdateCheckStaggerSeconds": 5
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
