{
  // === KGSM Scheduler — configuration ===
  //
  // This file declares the daemon's WHOLE configurable surface, each key with its default. It is
  // the floor; an environment variable overrides one key of it by spelling that key's path with
  // "__" — Scheduler__PollIntervalSeconds, Logging__LogLevel__Default. A variable naming a key
  // that is not declared here binds to nothing.
  //
  // Every key below maps 1:1 onto a property of SchedulerSettings, which the daemon binds in one
  // step. A test fails the build if the two ever disagree, in either direction.

  "Scheduler": {
    // Path to the KGSM executable, read for each server's schedule. Checked at startup — the
    // daemon refuses to run if nothing is there.
    "KgsmPath": "/usr/bin/kgsm",

    // The watchdog's control socket. Every scheduled restart is issued through the watchdog,
    // never directly, so this has to match the path the watchdog listens on.
    "WatchdogSocketPath": "/run/kgsm-watchdog/control.sock",

    // Unix socket the daemon answers on, over HTTP. A read of the schedule snapshot is a GET and an
    // instruction — postponing a window, say — is a POST, so one socket carries both. The unit
    // creates the parent directory (RuntimeDirectory=kgsm-scheduler).
    "SocketPath": "/run/kgsm-scheduler/scheduler.sock",

    // Unix socket the daemon answers for ITSELF on: its configuration, its unit, its journal and the
    // commands it declares. The Control Panel reaches it through the node's API, which relays here.
    "SurfaceSocketPath": "/run/kgsm-scheduler/surface.sock",

    // The env file a configuration change made through the Control Panel is written to. It has to be
    // a file this unit loads with EnvironmentFile=, or the panel reports the settings read-only.
    "ConfigOverridePath": "/var/lib/kgsm-api/leaf-overrides/scheduler.env",

    // Directory the daemon keeps its own state in — which servers have already been told a restart
    // is coming, so a restart of this daemon neither repeats the warnings nor forgets it made them.
    // The unit creates it (StateDirectory=kgsm-scheduler).
    "StateDirectory": "/var/lib/kgsm-scheduler",

    // The node's replica of the cluster's authority, read and never written. A window runs only while
    // both this service and the person who wrote it may do what it does, and a sweep only while both
    // this service and the person who switched it on may read the server.
    "AuthorityReplicaPath": "/var/lib/kgsm/auth/users.db",

    // The host file the node on this machine names itself in, which names this service's account.
    "ProviderFilePath": "/var/lib/kgsm/cluster/auth-provider.json",

    // How often each server's schedule is re-read from KGSM (seconds). This bounds how quickly a
    // schedule change takes effect; it does not affect the accuracy of a fire already scheduled.
    // Anything below 5 is raised to 5.
    "PollIntervalSeconds": 60,

    // How late a missed maintenance window may be and still run (minutes). Anything later is
    // skipped, so a host that was down does not come back to a burst of catch-up work. Capped at
    // half the window's own period, and floored at one poll interval.
    "GraceWindowMinutes": 10,

    // The shortest period this host permits a maintenance window to have (minutes). A window asking
    // to run more often is reported as one this host will not fire. Anything below 10 is raised
    // to 10 — the grammar's own floor, which a host policy cannot undercut.
    "MinimumWindowPeriodMinutes": 10,

    // Whether maintenance that interrupts the people on a server — a restart, or an update — may run
    // on this host at all. False leaves backups running as normal; anything disruptive is recorded
    // as skipped, and the windows carrying it are not announced.
    "AllowDisruptiveTasks": true,

    // Whether to sweep every server for a newer game build. False means nothing on this host ever
    // asks upstream, so no update is announced — servers keep running exactly as they are. Off until
    // somebody switches it on through the Control Panel, who is then recorded as its author: each
    // server is checked only while both this service and that person may read it.
    "UpdateCheckEnabled": false,

    // How often the whole roster is swept (minutes). A game release is not a fast-moving fact and
    // each server asks its own upstream, so the cost is linear in servers. Anything below 5 is
    // raised to 5.
    "UpdateCheckIntervalMinutes": 60,

    // Pause between one server's check and the next, within a sweep (seconds). The sweep is serial
    // by design; this spreads the requests out further still.
    "UpdateCheckStaggerSeconds": 5
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
