<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TheKrystalShip.Kgsm.Scheduler</RootNamespace>
    <AssemblyName>kgsm-scheduler</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>3.1.0</Version>

    <!-- The leaf config descriptor is generated from SchedulerSettings. These name the two files the
         generator works between; the attribute source, the documentation file the <panel> tags travel
         in, and the build step all come with the package below. -->
    <LeafSettingsFile>kgsm-scheduler.settings.json</LeafSettingsFile>
    <LeafDescriptorFile>$(MSBuildProjectDirectory)/../../deploy/kgsm-scheduler.leaf.json</LeafDescriptorFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-only: the descriptor attributes arrive as source and the generator as a tool, and the
         package declares no dependencies, so nothing here reaches the AOT publish. -->
    <PackageReference Include="TheKrystalShip.KGSM.LeafConfig" Version="2.2.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageReference Include="TheKrystalShip.KGSM.Lib" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scheduler.Tests" />
  </ItemGroup>

</Project>
