<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TheKrystalShip.Kgsm.Scheduler</RootNamespace>
    <AssemblyName>kgsm-scheduler</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>5.1.2</Version>

    <!-- The leaf config descriptor is generated from SchedulerSettings. These name the two files the
         generator works between; the attribute source, the documentation file the <panel> tags travel
         in, and the build step all come with the package below. -->
    <ComponentSettingsFile>kgsm-scheduler.settings.json</ComponentSettingsFile>
    <ComponentDescriptorFile>$(MSBuildProjectDirectory)/../../deploy/kgsm-scheduler.leaf.json</ComponentDescriptorFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-only: the descriptor attributes arrive as source and the generator as a tool, and the
         package declares no dependencies, so nothing here reaches the AOT publish. -->
    <PackageReference Include="TheKrystalShip.KGSM.ComponentConfig" Version="4.0.0" PrivateAssets="all" />

    <!-- What this daemon answers about ITSELF with: its descriptor, the deploy floors under it, the
         override file, its journal and its unit. The transport half maps those onto the routes every
         component serves them at, so this leaf and an anchor answer the same questions the same way. -->
    <PackageReference Include="TheKrystalShip.KGSM.ComponentSurface" Version="2.0.0" />
    <PackageReference Include="TheKrystalShip.KGSM.ComponentSurface.Http" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Configuration, hosting, logging and options all arrive with the ASP.NET Core framework
         reference the Web SDK carries, so naming them here would pin a second copy of what is
         already in the shared framework. -->
    <PackageReference Include="TheKrystalShip.KGSM.Engine" Version="4.0.0-dev.9" />
    <PackageReference Include="TheKrystalShip.KGSM.Watchdog.Client" Version="1.0.0-dev.2" />
    <PackageReference Include="TheKrystalShip.KGSM.Journal" Version="2.6.0-dev.1" />

    <!-- The people the control routes admit: the access token the node relays is checked against the
         sign-in provider's keys, and the actions it lists decide what the person may tell this daemon. -->
    <PackageReference Include="TheKrystalShip.Auth.Sessions" Version="1.0.0-dev.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scheduler.Tests" />
  </ItemGroup>

</Project>
